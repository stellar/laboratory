{
  "name": "stellar-laboratory",
  "version": "0.1.0",
  "author": "Stellar Development Foundation <stellar@stellar.org>",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "fetch-limits": "node scripts/fetch-network-limits.mjs",
    "predev": "pnpm fetch-limits",
    "dev": "NEXT_PUBLIC_COMMIT_HASH=$(git rev-parse --short HEAD) NEXT_PUBLIC_ENABLE_EXPLORER=true next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:ts": "tsc --noEmit",
    "test:unit": "jest",
    "test:e2e": "playwright test",
    "test": "pnpm test:unit && pnpm test:e2e",
    "install-if-package-changed": "git diff-tree -r --name-only --no-commit-id ORIG_HEAD HEAD | grep --quiet pnpm.lock && pnpm install || exit 0",
    "prepare": "husky",
    "pre-commit": "pnpm lint-staged",
    "pre-push": "pnpm lint:ts && pnpm test:e2e && pnpm test:unit",
    "playwright-ui": "npx playwright test --ui"
  },
  "dependencies": {
    "@amplitude/analytics-browser": "^2.48.1",
    "@creit.tech/stellar-wallets-kit": "^2.7.1",
    "@ledgerhq/hw-app-str": "^7.8.0",
    "@ledgerhq/hw-transport-webhid": "^6.36.0",
    "@monaco-editor/react": "^4.7.0",
    "@next/third-parties": "^16.4.2",
    "@sentry/nextjs": "^11.8.0",
    "@stellar-expert/contract-wasm-interface-parser": "^6.0.1",
    "@stellar/design-system": "^4.0.2",
    "@stellar/stellar-sdk": "17.4.0",
    "@stellar/stellar-xdr-json": "^28.0.0",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-query-devtools": "^5.104.5",
    "@trezor/connect-web": "10.0.1",
    "@trezor/network-stellar": "10.0.1",
    "bignumber.js": "^11.1.5",
    "buffer": "^6.0.3",
    "dompurify": "^3.4.17",
    "html-react-parser": "^6.1.9",
    "immer": "^11.2.7",
    "lodash": "^4.18.1",
    "lossless-json": "^4.3.3",
    "next": "16.4.2",
    "papaparse": "^5.7.0",
    "react": "^19.3.1",
    "react-diff-viewer": "^3.1.1",
    "react-dom": "^19.3.1",
    "stellar-hd-wallet": "^1.0.2",
    "tslib": "^2.8.1",
    "uuid": "^14.0.3",
    "zustand": "^5.0.6",
    "zustand-querystring": "^0.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tanstack/eslint-plugin-query": "^5.104.5",
    "@types/jest": "^30.0.0",
    "@types/json-schema": "^7.0.15",
    "@types/lodash": "^4.17.27",
    "@types/node": "^26.6.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "sass": "^1.106.1",
    "ts-jest": "^29.4.6",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@10.15.1"
}
